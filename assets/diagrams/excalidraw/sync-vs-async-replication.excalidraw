  {
   "id": "n-label",
   "type": "text",
   "x": 690,
   "y": 113.125,
   "width": 271.1,
   "height": 123.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 469805696,
   "version": 1,
   "versionNonce": 1158328394,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Sync: no data loss on leader\nfailure, but write latency +1 RTT\nand writes stall if follower dies.\nSemi-sync: 1 sync + rest async.\nAsync: fast, but a failover can\nlose the last seconds of writes.",
   "fontSize": 16.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n",
   "originalText": "Sync: no data loss on leader\nfailure, but write latency +1 RTT\nand writes stall if follower dies.\nSemi-sync: 1 sync + rest async.\nAsync: fast, but a failover can\nlose the last seconds of writes.",
   "lineHeight": 1.25,
   "autoResize": true
  },
