   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Decrypt: send encrypted DEK to KMS -> get DEK -> decrypt locally. Rotating the KEK re-wraps DEKs,\nnot all the data. KMS calls are audited and permissioned per key.",
   "fontSize": 16.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n",
   "originalText": "Decrypt: send encrypted DEK to KMS -> get DEK -> decrypt locally. Rotating the KEK re-wraps DEKs,\nnot all the data. KMS calls are audited and permissioned per key.",
   "lineHeight": 1.25,
   "autoResize": true
  },
