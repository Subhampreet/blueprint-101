   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Both sides derive the same session\nkey from ephemeral ECDHE shares:\nforward secrecy.\nCert proves server identity\n(signed by a trusted CA).\nTLS 1.2 needed 2 RTT.",
   "fontSize": 16.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n",
   "originalText": "Both sides derive the same session\nkey from ephemeral ECDHE shares:\nforward secrecy.\nCert proves server identity\n(signed by a trusted CA).\nTLS 1.2 needed 2 RTT.",
   "lineHeight": 1.25,
   "autoResize": true
  },
