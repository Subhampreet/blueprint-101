   "updated": 1,
   "link": null,
   "locked": false,
   "text": "N = 5, W = 3, R = 3: 3 + 3 > 5, so at least one replica in every read set has v2.\nThe reader picks the highest version and can fix stale replicas (read repair).",
   "fontSize": 16.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n",
   "originalText": "N = 5, W = 3, R = 3: 3 + 3 > 5, so at least one replica in every read set has v2.\nThe reader picks the highest version and can fix stale replicas (read repair).",
   "lineHeight": 1.25,
   "autoResize": true
  },
