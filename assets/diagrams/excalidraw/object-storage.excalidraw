   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Immutable objects, flat namespace.\nDurability via replication (3x) or\nerasure coding (e.g. 10+4) across\nracks and AZs. Big uploads use\nmultipart + presigned URLs, so\nbytes skip your app servers.",
   "fontSize": 16.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n",
   "originalText": "Immutable objects, flat namespace.\nDurability via replication (3x) or\nerasure coding (e.g. 10+4) across\nracks and AZs. Big uploads use\nmultipart + presigned URLs, so\nbytes skip your app servers.",
   "lineHeight": 1.25,
