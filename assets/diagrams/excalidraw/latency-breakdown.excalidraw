   "versionNonce": 2007311184,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Latency = time for ONE request.\nThroughput = requests finished per second.\nLittle's law: in-flight = throughput x latency.",
   "fontSize": 16.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n",
   "originalText": "Latency = time for ONE request.\nThroughput = requests finished per second.\nLittle's law: in-flight = throughput x latency.",
   "lineHeight": 1.25,
   "autoResize": true
  },
