   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Biggest wins usually: avoid round trips,\nkeep connections warm, cache close to the user,\nparallelize independent calls.",
   "fontSize": 16.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n2",
   "originalText": "Biggest wins usually: avoid round trips,\nkeep connections warm, cache close to the user,\nparallelize independent calls.",
   "lineHeight": 1.25,
   "autoResize": true
  },
