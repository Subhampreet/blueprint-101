  {
   "id": "n-label",
   "type": "text",
   "x": 50,
   "y": 267.06,
   "width": 370.26,
   "height": 61.88,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
