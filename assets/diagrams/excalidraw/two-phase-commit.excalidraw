   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Phase 2: all yes -> COMMIT,\nany no -> ABORT.\n\nBlocking: if the coordinator\ndies after prepare, participants\nhold locks and cannot decide\nalone. Latency = 2 round trips\n+ fsyncs at every step.",
   "fontSize": 16.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n",
   "originalText": "Phase 2: all yes -> COMMIT,\nany no -> ABORT.\n\nBlocking: if the coordinator\ndies after prepare, participants\nhold locks and cannot decide\nalone. Latency = 2 round trips\n+ fsyncs at every step.",
   "lineHeight": 1.25,
   "autoResize": true
  },
