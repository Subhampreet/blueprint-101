   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Any bit = 0  ->  definitely not present.   All bits = 1  ->  probably present (false positive possible).\nm = -n ln(p) / (ln 2)^2 bits, k = (m/n) ln 2.  ~10 bits per item gives ~1% false positives. No deletes (use counting variant).",
   "fontSize": 16.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n",
   "originalText": "Any bit = 0  ->  definitely not present.   All bits = 1  ->  probably present (false positive possible).\nm = -n ln(p) / (ln 2)^2 bits, k = (m/n) ln 2.  ~10 bits per item gives ~1% false positives. No deletes (use counting variant).",
   "lineHeight": 1.25,
   "autoResize": true
  },
