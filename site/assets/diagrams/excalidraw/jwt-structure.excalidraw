   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Signed, NOT encrypted: anyone can read the payload. Verify signature (public key from JWKS), exp, iss, aud.\nShort expiry (5 to 15 min) + refresh tokens, because a stateless JWT cannot be revoked before it expires.",
   "fontSize": 16.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n",
   "originalText": "Signed, NOT encrypted: anyone can read the payload. Verify signature (public key from JWKS), exp, iss, aud.\nShort expiry (5 to 15 min) + refresh tokens, because a stateless JWT cannot be revoked before it expires.",
