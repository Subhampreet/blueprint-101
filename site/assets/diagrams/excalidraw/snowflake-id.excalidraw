   "updated": 1,
   "link": null,
   "locked": false,
   "text": "4,096 IDs per ms per worker = ~4M IDs/s per worker. No coordination at generation time.\nSorted by time across workers only roughly: clock skew can reorder IDs from different machines.",
   "fontSize": 16.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n",
   "originalText": "4,096 IDs per ms per worker = ~4M IDs/s per worker. No coordination at generation time.\nSorted by time across workers only roughly: clock skew can reorder IDs from different machines.",
