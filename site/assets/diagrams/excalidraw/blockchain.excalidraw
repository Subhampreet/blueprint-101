   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Changing any old transaction changes its block hash, which breaks every later prev_hash link.\nConsensus (PoW / PoS / BFT) decides which chain of blocks everyone accepts.",
   "fontSize": 16.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n",
   "originalText": "Changing any old transaction changes its block hash, which breaks every later prev_hash link.\nConsensus (PoW / PoS / BFT) decides which chain of blocks everyone accepts.",
   "lineHeight": 1.25,
   "autoResize": true
  },
